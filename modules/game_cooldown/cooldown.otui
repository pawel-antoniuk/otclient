SpellGroupIcon < UIWidget
  size: 22 24
  image-size: 20 20
  image-offset: 1 1
  image-source: /images/game/spells/spellgroup-icons-20x20
  image-color: #707070
  background-color: #3F3F3F
  focusable: false
  margin-top: 3
  border-width-top: 1
  border-color-top: #9F9F9F
  border-width-left: 1
  border-color-left: #9F9F9F
  $on:
    image-color: #FFFFFF


SpellIcon < UIWidget
  size: 22 24
  image-size: 20 20
  image-offset: 1 1
  image-color: #707070
  background-color: #3F3F3F
  focusable: false
  border-width-top: 1
  border-color-top: #9F9F9F
  border-width-left: 1
  border-color-left: #9F9F9F
  $!first:
    margin-left: 5

SpellProgressRect < UIProgressRect
  background: #000000
  percent: 100
  focusable: false
  horizontal-progress: true
  show-progress: false

GroupCooldownParticles < UIParticles
  effect: groupcooldown-effect

Panel
  id: cooldownWindow
  !text: tr('')
  size: 220 30
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  focusable: false
  phantom: true
  Panel
    id:contentsPanel2
    anchors.fill: parent
    margin-left: 5
    SpellGroupIcon
      id: groupIconAttack
      image-clip: 0 0 20 20
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 2

    SpellProgressRect
      id: progressRectAttack
      anchors.left: groupIconAttack.left
      anchors.bottom: groupIconAttack.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Attack')

    SpellGroupIcon
      id: groupIconHealing
      image-clip: 20 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconAttack.right
      margin-left: 3

    SpellProgressRect
      id: progressRectHealing
      anchors.left: groupIconHealing.left
      anchors.bottom: groupIconHealing.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Healing')

    SpellGroupIcon
      id: groupIconSupport
      image-clip: 40 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconHealing.right
      margin-left: 3

    SpellProgressRect
      id: progressRectSupport
      anchors.left: groupIconSupport.left
      anchors.bottom: groupIconSupport.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Support')

    SpellGroupIcon
      id: groupIconSpecial
      image-clip: 60 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconSupport.right
      margin-left: 3

    SpellProgressRect
      id: progressRectSpecial
      anchors.left: groupIconSpecial.left
      anchors.bottom: groupIconSpecial.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Special')

    SpellGroupIcon
      id: groupIconCrippling
      image-clip: 100 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconSpecial.right
      margin-left: 3

    SpellProgressRect
      id: progressRectCrippling
      anchors.left: groupIconCrippling.left
      anchors.bottom: groupIconCrippling.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Crippling')

    SpellGroupIcon
      id: groupIconFocus
      image-clip: 120 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconCrippling.right
      margin-left: 3

    SpellProgressRect
      id: progressRectFocus
      anchors.left: groupIconFocus.left
      anchors.bottom: groupIconFocus.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Focus')

    SpellGroupIcon
      id: groupIconUltimateStrikes
      image-clip: 140 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconFocus.right
      margin-left: 3

    SpellProgressRect
      id: progressRectUltimateStrikes
      anchors.left: groupIconUltimateStrikes.left
      anchors.bottom: groupIconUltimateStrikes.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Ultimate Strike')

    SpellGroupIcon
      id: groupIconGreatBeams
      image-clip: 160 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconUltimateStrikes.right
      margin-left: 3

    SpellProgressRect
      id: progressRectGreatBeams
      anchors.left: groupIconGreatBeams.left
      anchors.bottom: groupIconGreatBeams.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Great Beams')

    SpellGroupIcon
      id: groupIconBurstsOfNature
      image-clip: 180 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconGreatBeams.right
      margin-left: 3

    SpellProgressRect
      id: progressRectBurstsOfNature
      anchors.left: groupIconBurstsOfNature.left
      anchors.bottom: groupIconBurstsOfNature.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Bursts of Nature')

    SpellGroupIcon
      id: groupIconVirtue
      image-clip: 200 0 20 20
      anchors.top: parent.top
      anchors.left: groupIconBurstsOfNature.right
      margin-left: 3

    SpellProgressRect
      id: progressRectVirtue
      anchors.left: groupIconVirtue.left
      anchors.bottom: groupIconVirtue.bottom
      margin-left: 1
      width: 20
      height: 2
      !tooltip: tr('Virtue')

    VerticalSeparator
      id: separator
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 5
      margin-top: 2
      height: 24

    Panel
      height: 24
      id: cooldownPanel
      margin-top: 4
      margin-bottom: 3
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: prev.right
      anchors.right: parent.right
      layout:
        type: horizontalBox


